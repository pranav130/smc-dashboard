# ==============================================================================
# XAUTUSD Dashboard & 24/7 Paper Trading - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local testing. In production (Render/Railway),
# configure these as Environment Variables in the provider dashboard.

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# --- Security & Allowed Origins ---
# Comma-separated allowed CORS origins. Use * for development or specify your domain:
# e.g.: https://dashboard.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=*

# Optional Secret Key for protected administrative actions (e.g., resetting paper balance)
ADMIN_API_KEY=replace-with-a-secure-random-token-in-production

# --- Market Data Source (Delta Exchange India) ---
# Price Source: "index" for Benchmark Spot Gold (.DEXAUTUSD) or "mark" for Perpetual (XAUTUSD)
DELTA_PRICE_SOURCE=index
DELTA_REST_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange
DELTA_LEGACY_WS_URL=wss://socket.india.delta.exchange

# --- Persistent Database Configuration ---
# Local SQLite default: sqlite:///./data/paper_trading.db
# Render/Railway PostgreSQL example: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./data/paper_trading.db

# --- Paper Trading Configuration ---
# STRICT SIMULATION SAFETY LOCK - Real exchange orders are permanently disabled
EXECUTION_MODE=PAPER
INITIAL_PAPER_BALANCE=10000.00
DEFAULT_RISK_PER_TRADE_PCT=1.0
AUTO_PAPER_TRADING_ENABLED=true
